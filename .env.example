# Local-only database URL for a non-superuser login granted commerce_runtime. Leave empty in git.
COMMERCE_DATABASE_URL=

# The integration script accepts the CLI-provided DB_URL when COMMERCE_DATABASE_URL is unset.
DB_URL=

# Canonical non-secret application origin used for fixed Checkout return URLs.
APP_ORIGIN=

# Stripe test-mode secret only. Keep empty in git; live keys are rejected.
STRIPE_TEST_SECRET_KEY=

# Server-only Stripe sandbox endpoint signing secret; distinct from STRIPE_TEST_SECRET_KEY.
STRIPE_TEST_WEBHOOK_SECRET=

# Non-secret own-account Stripe sandbox account identifier used for account-scope verification.
STRIPE_TEST_ACCOUNT_ID=
