{
  "name": "brexcel",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf-typegen": "wrangler types --env-file .wrangler-types.env --env-interface CloudflareEnv worker-configuration.d.ts",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy -- --keep-vars",
    "start": "next start",
    "lint": "eslint",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "validate:publication": "tsc -p tsconfig.validation.json && node --test .validation-build/tests/publication.test.js && node .validation-build/scripts/validate-publication.js",
    "test:commerce": "tsc -p tsconfig.commerce.json && node --test .commerce-build/tests/commerce.test.js",
    "test:checkout": "tsc -p tsconfig.commerce.json && node --test .commerce-build/tests/checkout.test.js",
    "test:checkout:stripe": "tsc -p tsconfig.commerce.json && node .commerce-build/scripts/test-checkout-stripe.js",
    "test:commerce:integration": "tsc -p tsconfig.commerce.json && node .commerce-build/scripts/test-commerce-integration.js",
    "validate:commerce": "npm run test:commerce && npm run test:commerce:integration"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "next": "16.3.4",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "supabase": "2.117.0",
    "typescript": "^5",
    "wrangler": "4.131.0"
  }
}
