{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brexcel-staging",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "hyperdrive": [
    {
      "binding": "COMMERCE_DB",
      "id": "fce7a531bf6b4d74868cd5c34909eb82"
    }
  ],
  "vars": {
    "COMMERCE_PLATFORM": "worker",
    "APP_ORIGIN": "https://brexcel-staging.phpm095.workers.dev",
    "STRIPE_TEST_ACCOUNT_ID": "acct_1UEBit2I3MHghqus"
  },
  "secrets": {
    "required": ["STRIPE_TEST_SECRET_KEY", "STRIPE_TEST_WEBHOOK_SECRET"]
  },
  "observability": {
    "enabled": true
  }
}
